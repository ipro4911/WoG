// WolfMat - textured (non-custom) material group for the Spectrum wolf (Head7/Body7).
// Mirrors Default.material structure so setMaterial("WolfMat") resolves
// WolfMat/BodyMat, WolfMat/HeadMat, WolfMat/EyeMat, WolfMat/TeethMat,
// WolfMat/ManeMat, WolfMat/TailMat and WolfMat/WingMat.
material WolfMat/BodyMat
{
	receive_shadows on
	technique
	{
		pass
		{
			//Tint pulls Spectrum's light olive-tan paint into KITF's warmer palette
			ambient 0.720000 0.640000 0.740000 1.000000
			diffuse 0.720000 0.640000 0.740000 1.000000
			specular 0.010000 0.010000 0.010000 1.000000
			emissive 0.000000 0.000000 0.000000 1.000000
			texture_unit
			{
				texture wolfBodyTex.jpg
				tex_address_mode wrap
				filtering trilinear
			}
		}
	}
}
material WolfMat/HeadMat
{
	receive_shadows on
	technique
	{
		pass
		{
			//Tint pulls Spectrum's light tan paint into KITF's warmer palette
			ambient 0.700000 0.620000 0.720000 1.000000
			diffuse 0.700000 0.620000 0.720000 1.000000
			specular 0.010000 0.010000 0.010000 1.000000
			emissive 0.000000 0.000000 0.000000 1.000000
			texture_unit
			{
				texture wolfHeadTex.jpg
				tex_address_mode wrap
				filtering trilinear
			}
		}
	}
}
material WolfMat/EyeMat
{
	receive_shadows on
	technique
	{
		pass
		{
			ambient 1.000000 1.000000 1.000000 1.000000
			diffuse 1.000000 1.000000 1.000000 1.000000
			specular 0.050000 0.050000 0.050000 1.000000 12.500000
			emissive 0.000000 0.000000 0.000000 1.000000
			cull_hardware none
			cull_software none
			texture_unit
			{
				texture wolfEyeTex.jpg
				tex_address_mode wrap
				filtering trilinear
			}
		}
	}
}
